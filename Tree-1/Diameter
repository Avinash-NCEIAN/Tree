#include<bits/stdc++.h>
using namespace std;

vector<vector<int>> g;
vector<int> dist;

void dfs(int node,int par, int depth)
{
    dist[node] = depth;
    for(auto v: g[node]){
        if(v != par){
            dfs(v,node,depth+1);
        }
    }
}

int main()
{
    int n;
    cin>>n;
    g.resize(n+1);
    dist.assign(n+1,0);
    
    for(int i = 0;i<=n-1;i++){
        int x,y;
        cin>>x>>y;
        
        g[x].push_back(y);
        g[y].push_back(x);
        
    }
    
    dfs(1,0,0);
    int x = 1;
    for(int i = 1;i<=n;i++){
        if(dist[i]>dist[x]){
            x = i;
        }
    }
    
    dfs(x,0,0);
    int y = 1;
    for(int i = 1;i<=n;i++){
        if(dist[i]>dist[y]){
            y = i;
        }
    }
    
    //x-y is a diameter
    cout<<x<<" "<<y<<" "<<dist[y];
    
    return 0;
}
